{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "es2022"], "module": "esnext",
    "moduleResolution": "bundler", "jsx": "preserve", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules"]
}
